menu "otool_tab5_live2d app"

config OTOOL_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    help
      Configure the deployment Wi-Fi SSID in the local sdkconfig/menuconfig.
      An empty value disables Wi-Fi without aborting application startup.
      Do not place a real value in sdkconfig.defaults or another tracked file.

config OTOOL_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
    help
      Configure the deployment Wi-Fi password in the local sdkconfig/menuconfig.
      An empty value is accepted for an open network. Do not place a real value
      in sdkconfig.defaults or another tracked file.

config OTOOL_WIFI_MAX_RETRY
    int "Wi-Fi connect max retries"
    default 10
    range 1 100

config OTOOL_LLM_API_KEY
    string "Volcengine Ark API key"
    default ""
    help
      Configure the deployment API key in the local sdkconfig/menuconfig.
      An empty value disables the LLM and Agent workers without aborting the
      application. Do not place a real value in a tracked defaults file.

config OTOOL_LLM_MODEL
    string "Doubao model id"
    default "doubao-seed-2-1-turbo-260628"

config OTOOL_LLM_LLM_TASK_STACK_SIZE
    int "LLM worker task stack size (bytes)"
    default 32768
    range 8192 65536

config OTOOL_LLM_AGENT_TASK_STACK_SIZE
    int "Agent worker task stack size (bytes)"
    default 40960
    range 8192 65536

config OTOOL_LLM_UI_REFRESH_MS
    int "LLM UI refresh period (ms)"
    default 100
    range 20 1000

endmenu
