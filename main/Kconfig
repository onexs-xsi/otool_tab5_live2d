menu "otool_tab5_live2d app"

config OTOOL_WIFI_SSID
    string "Wi-Fi SSID (fallback; runtime value from NVS takes precedence)"
    default "xiaomibe72"
    help
        STA SSID to connect to after ESP-Hosted (C6) init.
        credential_store (NVS) overrides this at runtime: 'cred set wifi_ssid <name>'.

config OTOOL_WIFI_PASSWORD
    string "Wi-Fi password (placeholder; real value must be set via NVS)"
    default ""
    help
        WP0: 真实密码不写入仓库/固件。运行时通过 console 注入并持久化到 NVS：
            cred set wifi_pass <password>
        NVS 未设置时为空，设备无法连接 Wi-Fi。

config OTOOL_WIFI_MAX_RETRY
    int "Wi-Fi connect max retries"
    default 10
    range 1 100

config OTOOL_LLM_API_KEY
    string "Doubao Ark API key (runtime credential)"
    default ""
    help
        Passed to otool_llm_client at runtime; never compiled into the SDK.
        Set the value in your local sdkconfig (sdkconfig is git-ignored and
        never pushed). Example:
            idf.py menuconfig  ->  otool_tab5_live2d app  ->  Doubao Ark API key
        or add to sdkconfig.defaults locally without committing it.

config OTOOL_LLM_MODEL
    string "Doubao model id"
    default "doubao-seed-2-1-turbo-260628"

config OTOOL_LLM_LLM_TASK_STACK_SIZE
    int "LLM worker task stack size (bytes)"
    default 16384
    range 8192 65536

config OTOOL_LLM_UI_REFRESH_MS
    int "LLM UI refresh period (ms)"
    default 100
    range 20 1000

endmenu
