menu "otool_cubism_tool"

    config OTOOL_CUBISM_ENABLE_CLIP_PLAYER
        bool "Enable clip player mode (route D)"
        default y
        help
            Pre-rendered clip playback with interaction state machine.
            Safe-net / fallback for the REALTIME route (feasibility report §8).

    config OTOOL_CUBISM_ENABLE_STREAM_CLIENT
        bool "Enable stream client mode (route C)"
        default n
        help
            Host-rendered JPEG frame streaming (implementation pending S2b).

    config OTOOL_CUBISM_ENABLE_REALTIME
        bool "Enable realtime mode (self Core)"
        default n
        help
            On-device realtime rendering with the in-component self moc3/Core
            runtime. NOT IMPLEMENTED YET: enabling this fails the build until
            the generated Core feature manifest passes its Gates (G-LGL/G-FMT/
            G-BHV/G-SEC/G-TGT/G-RND/G-REL, §6.6).

    choice OTOOL_CUBISM_CORE_BACKEND
        prompt "Core backend"
        default OTOOL_CUBISM_CORE_BACKEND_NONE
        help
            REALTIME requires SELF. NONE means clip/stream only.
            (OFFICIAL/PURISM history was retired with the self-Core decision.)

        config OTOOL_CUBISM_CORE_BACKEND_NONE
            bool "None (clip/stream only)"

        config OTOOL_CUBISM_CORE_BACKEND_SELF
            bool "SELF (in-component ot_core_* runtime)"
    endchoice

    config OTOOL_CUBISM_MOC_PROFILE_V5
        bool "moc3 profile: version byte 5"
        default y
        help
            The only releasable model profile for the first version.
            Packages must declare a matching profile; mismatches are rejected
            before any large allocation.

    config OTOOL_CUBISM_ANIMATION_BACKEND_SELF
        bool "Animation backend: SELF (in-component, self-authored)"
        default y
        help
            Only animation backend. Motion/expression/pose/physics are all
            self-authored implementations (self-authored-code rule: no third
            party code or binaries may enter the component).

    config OTOOL_CUBISM_ENABLE_V6_OFFSCREEN
        bool "Enable moc3 v6 offscreen / extended blend (5.3+)"
        default n
        help
            Separate milestone; requires its own G-FMT/G-BHV/G-SEC/G-RND gates.

    choice OTOOL_CUBISM_RENDER_SIZE
        prompt "Realtime render size"
        default OTOOL_CUBISM_RENDER_SIZE_640X360
        help
            Scene buffer resolution; PPA scales it to the physical panel.

        config OTOOL_CUBISM_RENDER_SIZE_640X360
            bool "640x360 (2x upscale)"

        config OTOOL_CUBISM_RENDER_SIZE_512X288
            bool "512x288 (2.5x upscale)"

        config OTOOL_CUBISM_RENDER_SIZE_320X180
            bool "320x180 (4x upscale)"
    endchoice

    config OTOOL_CUBISM_RASTER_WORKERS
        int "Raster worker count"
        range 1 2
        default 1
        help
            Tile raster workers for the realtime renderer; decided by B3/B6.

    config OTOOL_CUBISM_METRICS
        bool "Collect runtime metrics"
        default y
        help
            Heap/frame metrics. Publish builds may keep the low-cost counters.

endmenu
